rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile & CS Bucks Wallet ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      
      allow create: if isOwner(userId);
      allow update: if isSignedIn() && (
        isOwner(userId) || 
        // Allow updating stats, rating, or balances via actions
        incoming().diff(existing()).affectedKeys().hasAny(['username', 'avatarUrl', 'bio', 'genre', 'tier', 'bamaBucks', 'csCoins', 'xp', 'learningLevel', 'ratings', 'dailyDropsUsed', 'crewId', 'isBanned', 'bannedReason'])
      );
    }

    // --- Tracks & Drops ---
    match /tracks/{trackId} {
      allow read: if true;
      allow list: if true;
      
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (existing().authorId == request.auth.uid);
    }

    // --- 1v1 Battles ---
    match /battles/{battleId} {
      allow read: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // --- Anonymous Votes ---
    match /votes/{voteId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
    }

    // --- CS Bucks Ledger ---
    match /ledger/{txId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
    }

    // --- Crews (Syndicates) ---
    match /crews/{crewId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // --- Chat Rooms & Messages ---
    match /chats/{chatId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
    }

    // --- Learning Academy & Scoreboard ---
    match /learning/{scoreId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // --- Contests & Leagues ---
    match /contests/{contestId} {
      allow read: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // --- Matchmaking ---
    match /matchmaking/{requestId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
